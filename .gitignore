# Tool invocation logs. These live at ../.kb-logs/ (outside this repo) and are
# never committed anywhere. Listed here anyway in case anyone ever relocates the
# log root into the repo by mistake -- see ../tools/README.md.
.kb-logs/
*.kblog.jsonl

__pycache__/
*.pyc
.ipynb_checkpoints/

# Heavy assets are registered with ../tools/assets.py, never stored here.
*.zip
*.tar.gz
*.parquet
*.sqlite
# Empty-until-it-finishes run logs. An empty .log sitting next to real ones
# implies a run that produced nothing, which is exactly the vacuous-success
# pattern this folder documents. Committed only when they have content.
papers/*/reanalysis/pimentel_stream.log
papers/*/reanalysis/pimentel_stream.err
